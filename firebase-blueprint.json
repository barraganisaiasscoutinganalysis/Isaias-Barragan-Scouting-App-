{
  "entities": {
    "MatchReport": {
      "title": "MatchReport",
      "description": "Complete tactical scouting report of a football match including lineups, ratings, and notes",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique report ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Auth UID of the owner scout",
          "maxLength": 128
        },
        "meta": {
          "type": "object",
          "description": "Metadata summary of the match and evaluation status"
        },
        "match": {
          "type": "object",
          "description": "Parsed match details including teams, players, events, and stats"
        },
        "evaluations": {
          "type": "object",
          "description": "Scout ratings and notes mapped by player ID"
        },
        "eventNotes": {
          "type": "object",
          "description": "Scout tactical annotations on specific match events"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the report was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the report was last updated"
        }
      },
      "required": ["id", "userId", "meta", "match", "createdAt", "updatedAt"]
    },
    "PlayerDossier": {
      "title": "PlayerDossier",
      "description": "Long-term scouting dossier and assessment of an individual football player",
      "type": "object",
      "properties": {
        "playerId": {
          "type": "string",
          "description": "Unique identifier of the player",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Auth UID of the scout",
          "maxLength": 128
        },
        "playerName": {
          "type": "string",
          "description": "Player full name",
          "maxLength": 120
        },
        "teamName": {
          "type": "string",
          "description": "Current club name",
          "maxLength": 120
        },
        "positionLabel": {
          "type": "string",
          "description": "Main tactical position",
          "maxLength": 50
        },
        "overallRating": {
          "type": "number",
          "description": "Scout overall evaluation grade"
        },
        "recommendation": {
          "type": "string",
          "enum": ["SIGN", "MONITOR", "DISCARD", "HOLD"],
          "description": "Scouting decision"
        },
        "projectedRole": {
          "type": "string",
          "description": "Projected squad role",
          "maxLength": 100
        },
        "strengths": {
          "type": "string",
          "description": "Key player strengths",
          "maxLength": 2000
        },
        "weaknesses": {
          "type": "string",
          "description": "Key player weaknesses",
          "maxLength": 2000
        },
        "summaryNotes": {
          "type": "string",
          "description": "Comprehensive scouting summary notes",
          "maxLength": 5000
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["playerId", "userId", "playerName", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/reports/{reportId}": {
      "schema": "MatchReport",
      "description": "Stores user-specific match scouting reports"
    },
    "/users/{userId}/playerDossiers/{playerId}": {
      "schema": "PlayerDossier",
      "description": "Stores user-specific player dossiers"
    }
  }
}
