rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection testing endpoint for health verification
    match /test/connection {
      allow read: if true;
    }

    // Match Scouting Reports scoped per user
    match /users/{userId}/reports/{reportId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) 
        && isValidId(reportId)
        && incoming().userId == userId
        && incoming().id == reportId;
      allow update: if isOwner(userId) 
        && isValidId(reportId)
        && incoming().userId == userId
        && incoming().id == existing().id;
      allow delete: if isOwner(userId) && isValidId(reportId);
    }

    // Player Dossiers scoped per user
    match /users/{userId}/playerDossiers/{playerId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) 
        && isValidId(playerId)
        && incoming().userId == userId
        && incoming().playerId == playerId;
      allow update: if isOwner(userId) 
        && isValidId(playerId)
        && incoming().userId == userId
        && incoming().playerId == existing().playerId;
      allow delete: if isOwner(userId) && isValidId(playerId);
    }
  }
}
